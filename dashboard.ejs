function renderRewards(){
  const balance = me ? me.balance : 0;
  const next = REWARDS.filter(r => r.cost > balance).sort((a, b) => a.cost - b.cost)[0] || null;
  const pct = next ? Math.min(100, Math.round(100 * balance / next.cost)) : 100;
  document.getElementById('rewardBalanceLabel').textContent = balance === 1 ? 'ponto disponível' : 'pontos disponíveis';
  document.getElementById('nextFill').style.width = pct + '%';
  document.getElementById('nextBar').setAttribute('aria-valuenow', String(pct));
  document.getElementById('nextText').textContent = next
    ? `Faltam ${pts(next.cost - balance)} para: ${next.name}.`
    : 'Você já pode resgatar qualquer prêmio do catálogo.';
  document.getElementById('rewardGrid').innerHTML = REWARDS.map(r => {
    const on = r.id === rw.selected;
    const locked = balance < r.cost;
    const progress = Math.min(100, Math.round(100 * balance / r.cost));
    return `<button type="button" class="mat-card${on ? ' selected' : ''}${locked ? ' locked' : ''}" role="radio" aria-checked="${on}" data-reward="${esc(r.id)}"><span class="mat-ico" aria-hidden="true">${REWARD_ICON[r.id] || '🎁'}</span><b>${esc(r.name)}</b><small>${r.cost} pts · ${locked ? 'faltam ' + (r.cost - balance) : 'disponível'}</small>${locked ? `<span class="mini-bar"><i style="width:${progress}%"></i></span>` : ''}</button>`;
  }).join('');
  const chosen = REWARDS.find(r => r.id === rw.selected);
  const affordable = balance >= chosen.cost;
  document.getElementById('rewardSummary').innerHTML = `
    <div class="reward-summary">
      <div class="sum-row"><span>Prêmio</span><b>${esc(chosen.name)}</b></div>
      <div class="sum-row"><span>Custo</span><b>${pts(chosen.cost)}</b></div>

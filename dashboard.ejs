const parseUtc = s => new Date(s.replace(' ', 'T') + 'Z');
const dayKey = d => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
const PALETTE = ['#ffffff', '#d7f5c9', '#ffd36b', '#8be0c4', '#9ec5ff', '#ffa8a8', '#e6c1ff', '#ffb870'];

function lastDays(n){
  const base = new Date();
  base.setHours(0, 0, 0, 0);
  const out = [];
  for(let i = n - 1; i >= 0; i--){
    const d = new Date(base);
    d.setDate(base.getDate() - i);
    out.push(d);
  }
  return out;
}

function chartDias(){
  const days = lastDays(7);
  const counts = new Map(days.map(d => [dayKey(d), 0]));
  doneList().forEach(x => {
    const k = dayKey(parseUtc(x.validatedAt || x.createdAt));
    if(counts.has(k)) counts.set(k, counts.get(k) + 1);
  });
  const values = days.map(d => counts.get(dayKey(d)));
  const total = values.reduce((a, b) => a + b, 0);
  const max = Math.max(1, ...values);
  const W = 320, H = 170, base = 135, top = 28, slot = W / 7, bw = 26;
  let shapes = '';
  days.forEach((d, i) => {
    const v = values[i];
    const h = v ? Math.max(4, Math.round((base - top) * v / max)) : 2;
    const x = i * slot + (slot - bw) / 2;
    const label = d.toLocaleDateString('pt-BR', { weekday: 'short' }).replace('.', '');
    shapes += `<rect x="${x}" y="${base - h}" width="${bw}" height="${h}" rx="5" fill="#fff" opacity="${v ? 1 : .35}"/>`;
    if(v) shapes += `<text x="${x + bw / 2}" y="${base - h - 7}" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">${v}</text>`;
    shapes += `<text x="${x + bw / 2}" y="${base + 20}" text-anchor="middle" font-size="12" fill="#fff" opacity=".9">${esc(label)}</text>`;
  });
  return {
    html: `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Descartes por dia nos últimos 7 dias">${shapes}<line x1="0" y1="${base}" x2="${W}" y2="${base}" stroke="#fff" opacity=".35"/></svg>`,
    note: total === 1 ? '1 descarte nos últimos 7 dias.' : `${total} descartes nos últimos 7 dias.`
  };
}

function chartMateriais(){
  const sums = new Map();
  doneList().forEach(x => { const name = x.finalMaterial || x.material; sums.set(name, (sums.get(name) || 0) + (x.finalQty || x.qty)); });
  const entries = [...sums.entries()].sort((a, b) => b[1] - a[1]);
  const total = entries.reduce((a, e) => a + e[1], 0);
  const r = 46, C = 2 * Math.PI * r;
  let offset = 0, arcs = '';
  entries.forEach(([name, v], i) => {
    const len = C * v / total;
    arcs += `<circle cx="60" cy="60" r="${r}" fill="none" stroke="${PALETTE[i % PALETTE.length]}" stroke-width="20" stroke-dasharray="${len} ${C - len}" stroke-dashoffset="${-offset}" transform="rotate(-90 60 60)"/>`;
    offset += len;
  });
  const legend = entries.map(([name, v], i) =>
    `<li><i style="background:${PALETTE[i % PALETTE.length]}"></i><span>${esc(name)} — ${v} (${Math.round(100 * v / total)}%)</span></li>`).join('');
  return {
    html: `<div class="donut-wrap"><svg viewBox="0 0 120 120" role="img" aria-label="Itens descartados por material">${arcs}<text x="60" y="58" text-anchor="middle" font-size="20" font-weight="700" fill="#fff">${total}</text><text x="60" y="74" text-anchor="middle" font-size="9" fill="#fff" opacity=".9">itens</text></svg><ul class="legend">${legend}</ul></div>`,
    note: 'Quantidade informada em cada descarte, por tipo de material.'
  };
}

function chartPontos(){
  const days = lastDays(14);
  const perDay = new Map(days.map(d => [dayKey(d), 0]));
  doneList().forEach(x => {
    const k = dayKey(parseUtc(x.validatedAt || x.createdAt));
    if(perDay.has(k)) perDay.set(k, perDay.get(k) + x.points);
  });
  const inWindow = [...perDay.values()].reduce((a, b) => a + b, 0);
  let running = me.earned - inWindow;
  const values = days.map(d => (running += perDay.get(dayKey(d))));
  const lo = Math.min(...values), hi = Math.max(...values);
  const min = lo === hi ? lo - 1 : lo, max = lo === hi ? hi + 1 : hi;
  const W = 320, H = 170, left = 38, right = 14, top = 26, bottom = 135;
  const x = i => left + i * (W - left - right) / (values.length - 1);
  const y = v => bottom - (bottom - top) * (v - min) / (max - min);
  const line = values.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
  const area = `${x(0).toFixed(1)},${bottom} ${line} ${x(values.length - 1).toFixed(1)},${bottom}`;
  const fmt = d => String(d.getDate()).padStart(2, '0') + '/' + String(d.getMonth() + 1).padStart(2, '0');
  const dots = values.map((v, i) => `<circle cx="${x(i).toFixed(1)}" cy="${y(v).toFixed(1)}" r="${i === values.length - 1 ? 4.5 : 2.5}" fill="#fff"/>`).join('');
  const last = values.length - 1;
  return {
    html: `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Pontos ganhos acumulados nos últimos 14 dias">
      <polygon points="${area}" fill="#fff" opacity=".18"/>
      <polyline points="${line}" fill="none" stroke="#fff" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/>${dots}
      <text x="${left - 6}" y="${y(max) + 4}" text-anchor="end" font-size="11" fill="#fff" opacity=".9">${Math.round(max)}</text>
      <text x="${left - 6}" y="${y(min) + 4}" text-anchor="end" font-size="11" fill="#fff" opacity=".9">${Math.round(min)}</text>
      <text x="${x(last)}" y="${y(values[last]) - 10}" text-anchor="end" font-size="13" font-weight="700" fill="#fff">${values[last]}</text>
      <text x="${left}" y="${bottom + 20}" text-anchor="start" font-size="11" fill="#fff" opacity=".9">${fmt(days[0])}</text>
      <text x="${W - right}" y="${bottom + 20}" text-anchor="end" font-size="11" fill="#fff" opacity=".9">hoje</text>
    </svg>`,
    note: `Pontos ganhos acumulados nos últimos 14 dias (total: ${me.earned}).`
  };
}

function renderChart(){
  const box = document.getElementById('chartBox');
  const note = document.getElementById('chartNote');
  if(!me || !doneList().length){
    box.innerHTML = '<p class="on-green-empty">Registre seu primeiro descarte para ver os gráficos.</p>';
    note.textContent = '';
    return;
  }
  const chart = currentChart === 'materiais' ? chartMateriais() : currentChart === 'pontos' ? chartPontos() : chartDias();
  box.innerHTML = chart.html;
  note.textContent = chart.note;
}


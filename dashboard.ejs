document.getElementById('invPoint').innerHTML = POINTS.map(p => `<option value="${p.id}">${esc(p.name)}</option>`).join('');

let lookedUp = null;

function updateResPoints(){
  const mat = MATERIALS.find(m => m.id === val('resMaterial'));
  const qty = Number(val('resQty'));
  document.getElementById('resPoints').textContent = mat && Number.isInteger(qty) && qty >= 1 && qty <= 50
    ? `Pontos a creditar: ${pts(mat.pts * qty)}.`
    : 'Informe uma quantidade inteira de 1 a 50.';
}
document.getElementById('resMaterial').addEventListener('change', updateResPoints);
document.getElementById('resQty').addEventListener('input', updateResPoints);

function showResult(r){
  lookedUp = r;
  document.getElementById('resWho').textContent = `${r.resident} · ${r.point}`;
  document.getElementById('resDecl').textContent = `Declarado: ${r.material} × ${r.qty}. Código vale até ${when(r.expiresAt)}.`;
  document.getElementById('resMaterial').value = r.materialId;
  document.getElementById('resQty').value = r.qty;
  updateResPoints();
  document.getElementById('staffResult').hidden = false;
}

async function staffLookup(){
  const code = codeOnly(val('staffCode'));
  document.getElementById('staffResult').hidden = true;
  lookedUp = null;
  if(code.length !== 8){ setMsg('staffMsg', 'Digite o código de 8 caracteres.', false); return; }
  setMsg('staffMsg', 'Buscando...', true);
  try{
    const r = await api('/api/staff/lookup', { code });
    setMsg('staffMsg', 'Código encontrado. Confira o material e a quantidade.', true);
    showResult(r);
  }catch(err){
    setMsg('staffMsg', err.message, false);
  }
}

async function staffAct(action){
  if(!lookedUp) return;
  const buttons = [document.getElementById('resOk'), document.getElementById('resNo')];
  buttons.forEach(b => { b.disabled = true; });
  const body = { code: lookedUp.code, action };
  if(action === 'validar'){ body.material = val('resMaterial'); body.qty = Number(val('resQty')); }
  else body.reason = val('resReason');
  try{
    const r = await api('/api/staff/validate', body);
    setMsg('staffMsg', action === 'validar' ? `Descarte validado! ${pts(r.points)} creditados ao morador.` : 'Descarte recusado.', true);
    document.getElementById('staffResult').hidden = true;
    document.getElementById('staffCode').value = '';
    lookedUp = null;
    await loadRecent();
  }catch(err){
    setMsg('staffMsg', err.message, false);
  }finally{
    buttons.forEach(b => { b.disabled = false; });
  }
}

document.getElementById('staffLookup').addEventListener('click', staffLookup);
document.getElementById('staffCode').addEventListener('keydown', e => { if(e.key === 'Enter') staffLookup(); });
document.getElementById('resOk').addEventListener('click', () => staffAct('validar'));
document.getElementById('resNo').addEventListener('click', () => staffAct('recusar'));

let scanStream = null;
let scanTimer = null;

function loadScript(url){
  return new Promise((resolve, reject) => {
    const el = document.createElement('script');
    el.src = url;
    el.onload = resolve;
    el.onerror = () => reject(new Error('Não foi possível carregar o leitor.'));
    document.head.appendChild(el);
  });
}

function stopScan(){
  clearInterval(scanTimer);
  scanTimer = null;
  if(scanStream){ scanStream.getTracks().forEach(t => t.stop()); scanStream = null; }
  const video = document.getElementById('scanVideo');
  video.srcObject = null;
  document.getElementById('scanBox').hidden = true;
}

async function startScan(){
  if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
    setMsg('staffMsg', 'Este navegador não permite usar a câmera. Digite o código.', false);
    return;
  }
  try{
    scanStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' }, audio: false });
  }catch(err){
    setMsg('staffMsg', 'Não foi possível abrir a câmera. Permita o acesso ou digite o código.', false);
    return;
  }
  const video = document.getElementById('scanVideo');
  video.srcObject = scanStream;
  document.getElementById('scanBox').hidden = false;
  try{ await video.play(); }catch(e){}
  setMsg('staffMsg', 'Aponte a câmera para o QR do morador.', true);
  const detector = 'BarcodeDetector' in window ? new BarcodeDetector({ formats: ['qr_code'] }) : null;
  if(!detector && !window.jsQR){
    try{ await loadScript('https://cdnjs.cloudflare.com/ajax/libs/jsQR/1.4.0/jsQR.min.js'); }catch(e){}
  }
  if(!detector && !window.jsQR){
    stopScan();
    setMsg('staffMsg', 'Não foi possível carregar o leitor de QR. Digite o código.', false);
    return;
  }
  const canvas = document.createElement('canvas');
  const ctx = canvas.getContext('2d', { willReadFrequently: true });
  let busy = false;
  scanTimer = setInterval(async () => {
    if(busy || video.readyState < 2 || !video.videoWidth) return;
    busy = true;
    try{
      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
      let text = null;
      if(detector){
        const found = await detector.detect(canvas);
        text = found[0] && found[0].rawValue;
      }else{
        const img = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const res = window.jsQR(img.data, img.width, img.height);
        text = res && res.data;
      }
      const code = codeOnly(text);
      if(code.length === 8){
        stopScan();
        document.getElementById('staffCode').value = code;
        await staffLookup();
      }
    }catch(e){}
    busy = false;
  }, 300);
}

document.getElementById('scanBtn').addEventListener('click', startScan);
document.getElementById('scanStop').addEventListener('click', () => { stopScan(); setMsg('staffMsg', '', true); });

async function loadRecent(){
  try{
    const data = await api('/api/staff/recent');
    document.getElementById('staffRecent').innerHTML = data.items.length
      ? data.items.map(x => {
        const done = x.status === 'validado';
        const extra = !done && x.rejectReason ? ' · ' + esc(x.rejectReason) : '';
        return `<div class="log-item${done ? '' : ' dim'}"><div><b>${esc(x.resident)} — ${esc(x.material)} × ${x.qty}</b><small>${esc(shortPoint(x.point))} · ${esc(when(x.validatedAt))} · por ${esc(x.validator || '—')}${extra}</small></div>${done ? `<span class="pts">+${x.points} pts</span>` : '<span class="badge">Recusado</span>'}</div>`;
      }).join('')
      : '<p class="on-green-empty">Nenhuma validação ainda.</p>';
  }catch(err){
    document.getElementById('staffRecent').innerHTML = '<p class="on-green-empty">' + esc(err.message) + '</p>';
  }
}


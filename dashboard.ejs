const CSRF = '<%= csrf %>';
const postsState = { items: [], filter: 'todos', query: '' };
let postPhotoData = null;
let noticeTimer = null;

const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const val = id => document.getElementById(id).value;

async function api(url, body){
  const options = body === undefined ? {} : {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ ...body, csrf: CSRF })
  };
  const res = await fetch(url, options);
  let data = null;
  try{ data = await res.json(); }catch(e){}
  if(res.status === 401){ window.location.href = '/login'; throw new Error('Sessão expirada. Entre novamente.'); }
  if(!res.ok) throw new Error((data && data.error) || 'Não foi possível concluir. Tente novamente.');
  return data;
}

function timeAgo(sqlDate){
  const t = new Date(sqlDate.replace(' ', 'T') + 'Z').getTime();
  const min = Math.max(0, Math.round((Date.now() - t) / 60000));
  if(min < 1) return 'agora';
  if(min < 60) return `há ${min} min`;
  const h = Math.round(min / 60);
  if(h < 24) return `há ${h} h`;
  const d = Math.round(h / 24);
  return `há ${d} ${d === 1 ? 'dia' : 'dias'}`;
}
function money(cents){
  return cents > 0 ? (cents / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) + ' pela retirada' : 'Sem valor';
}
function phoneText(d){
  return d.length === 11 ? `(${d.slice(0,2)}) ${d.slice(2,7)}-${d.slice(7)}` : `(${d.slice(0,2)}) ${d.slice(2,6)}-${d.slice(6)}`;
}
function whatsLink(p){
  return 'https://wa.me/55' + p.contact + '?text=' + encodeURIComponent('Olá! Vi sua postagem "' + p.title + '" no RecyTech e posso fazer a retirada.');
}

function visiblePosts(){
  const q = postsState.query.trim().toLowerCase();
  return postsState.items.filter(p => {
    if(postsState.filter === 'abertos' && p.status !== 'aberto') return false;
    if(postsState.filter === 'minhas' && !p.mine) return false;
    if(!q) return true;
    return (p.title + ' ' + p.category + ' ' + p.address + ' ' + p.bairro).toLowerCase().includes(q);
  });
}


        ${open ? `<a class="whats" href="${esc(whatsLink(p))}" target="_blank" rel="noopener noreferrer">Chamar no WhatsApp</a>` : ''}
        <span class="phone">${esc(phoneText(p.contact))}</span>${owner}
      </div>
    </div>
  </article>`;
}


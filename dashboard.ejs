<script nonce="<%= nonce %>">
const CATALOG = <%- catalogJson %>;
const MATERIALS = CATALOG.materials;
const POINTS = CATALOG.points;
const REWARDS = CATALOG.rewards;
const pts = n => n + (n === 1 ? ' ponto' : ' pontos');
let me = null;
let currentChart = 'dias';

function activateTab(tabId){
  document.querySelectorAll('.nav-btn').forEach(b=>{
    const on = b.dataset.tab === tabId;
    b.classList.toggle('active', on);
    if(on) b.setAttribute('aria-current', 'page'); else b.removeAttribute('aria-current');
  });
  document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('active', p.id===tabId));
  window.scrollTo(0, 0);
  if(tabId==='mapa'){ renderPoints(); if(window.leafletMapReady) setTimeout(()=>leafletMap.invalidateSize(), 50); }
  if(tabId==='posts') loadPosts();
  if(tabId==='perfil' || tabId==='recompensas' || tabId==='registrar') loadMe();
  if(tabId==='registrar') renderRegister();
  if(tabId==='equipe') loadTeam();
}
document.querySelectorAll('.nav-btn').forEach(btn=>btn.addEventListener('click', ()=> activateTab(btn.dataset.tab)));

const leafletMap = L.map('realMap').setView([-19.9678, -44.1979], 12);
window.leafletMapReady = true;
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
  maxZoom: 19,
  attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contribuidores'
}).addTo(leafletMap);

const greenIcon = L.divIcon({
  className: '',
  html: '<div style="width:16px;height:16px;background:#1f8a4c;border:3px solid #fff;border-radius:50% 50% 50% 0;transform:rotate(45deg);box-shadow:0 2px 6px rgb(252, 251, 251);"></div>',
  iconSize: [16,16],
  iconAnchor: [8,16]
});

const markers = {};
POINTS.forEach(p=>{
  markers[p.id] = L.marker([p.lat, p.lng], {icon:greenIcon}).addTo(leafletMap)
    .bindPopup(`<b>${p.name}</b><br>${p.endereco ? p.endereco+'<br>' : ''}Bairro: ${p.bairro}<br>Aceita: ${p.aceita}${p.geocoded===false ? '<br><i>⚠ coordenada aproximada, a confirmar</i>' : ''}`);
});

const DIAS = ['domingo', 'segunda', 'terça', 'quarta', 'quinta', 'sexta', 'sábado'];
const toMin = hhmm => { const [h, m] = hhmm.split(':').map(Number); return h * 60 + m; };
const hourLabel = min => (min % 60 ? `${Math.floor(min / 60)}h${String(min % 60).padStart(2, '0')}` : `${Math.floor(min / 60)}h`);

function betimNow(date = new Date()){
  const parts = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Sao_Paulo', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(date);
  const get = type => parts.find(p => p.type === type).value;
  return { day: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(get('weekday')), minutes: Number(get('hour')) * 60 + Number(get('minute')) };
}

function hoursStatus(point, date = new Date()){
  const h = point.horario, opens = toMin(h.abre), closes = toMin(h.fecha), now = betimNow(date);
  const workday = h.dias.includes(now.day);
  if(workday && now.minutes >= opens && now.minutes < closes) return { open: true, text: `Aberto agora · fecha às ${hourLabel(closes)}` };
  if(workday && now.minutes < opens) return { open: false, text: `Fechado · abre hoje às ${hourLabel(opens)}` };
  for(let i = 1; i <= 7; i++){
    const day = (now.day + i) % 7;
    if(h.dias.includes(day)) return { open: false, text: `Fechado · abre ${i === 1 ? 'amanhã' : DIAS[day]} às ${hourLabel(opens)}` };
  }
  return { open: false, text: 'Fechado' };
}

function mapsLink(p){
  return 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(`${p.endereco}, ${p.bairro}, Betim - MG`);
}

function renderPoints(){
  document.getElementById('pointsList').innerHTML = POINTS.map(p => {
    const s = hoursStatus(p);
    const title = p.name.replace(/^Ponto — /, '');
    return `
    <article class="rough tile">
      <h4>${esc(title)}</h4>
      ${p.endereco && p.endereco !== title ? `<p class="tile-addr">${esc(p.endereco)}</p>` : ''}
      <p class="tile-bairro">Bairro: ${esc(p.bairro)}</p>
      <p class="tile-hours"><span class="status ${s.open ? 'open' : 'closed'}">${esc(s.text)}</span><small>${esc(p.horario.texto)}${p.horario.estimado ? ' (estimado)' : ''}</small></p>
      <p class="tile-accepts">${esc(p.aceita)}</p>
      <div class="tile-actions">
        <button type="button" data-focus="${esc(p.id)}">Ver no mapa</button>
        <a href="${esc(mapsLink(p))}" target="_blank" rel="noopener noreferrer">Como chegar</a>
      </div>
    </article>`;
  }).join('');
}

function focusPoint(id){
  const p = POINTS.find(x => x.id === id);
  if(!p) return;
  document.getElementById('realMap').scrollIntoView({ behavior: 'smooth', block: 'center' });

async function loadTeam(){
  if(!me) await loadMe();
  if(!me || (me.role !== 'funcionario' && me.role !== 'admin')) return;
  document.getElementById('teamWhere').textContent = me.role === 'admin'
    ? 'Administrador: você valida descartes em qualquer ponto e gerencia a equipe.'
    : `Você valida descartes em: ${shortPoint(me.pointName)}.`;
  await Promise.all([loadRecent(), loadFlow()]);
  if(me.role === 'admin') await loadAdmin();
}


let flow = null;
let flowDays = 14;
let flowMetric = 'validated';
const METRIC_LABEL = { validated: 'descartes', items: 'itens', points: 'pontos' };
const flowColor = index => PALETTE[index % PALETTE.length];
const dayLabel = day => day.slice(8) + '/' + day.slice(5, 7);

function renderFlow(){
  if(!flow) return;
  const n = flow.days.length;
  const list = flow.points;
  const total = key => list.reduce((a, p) => a + p.totals[key], 0);
  const validatedTotal = total('validated');
  const refusedTotal = total('refused');
  const rate = validatedTotal + refusedTotal ? Math.round(100 * refusedTotal / (validatedTotal + refusedTotal)) + '%' : '—';
  document.getElementById('flowScope').textContent = flow.scope === 'all'
    ? `Todos os pontos · últimos ${n} dias`
    : `Apenas o seu ponto: ${shortPoint(list[0] ? list[0].name : '')} · últimos ${n} dias`;
  document.getElementById('flowKpis').innerHTML = [
    [validatedTotal, 'Descartes validados'],
    [total('items'), 'Itens recebidos'],
    [total('points'), 'Pontos creditados'],
    [rate, 'Taxa de recusa']
  ].map(([value, label]) => `<div class="kpi"><b>${value}</b><span>${label}</span></div>`).join('');
  document.getElementById('flowPending').textContent = `Aguardando validação agora: ${total('pending')}.`;

  const metric = flowMetric;
  const dayTotals = flow.days.map((_, i) => list.reduce((a, p) => a + p[metric][i], 0));
  const grand = dayTotals.reduce((a, b) => a + b, 0);
  const box = document.getElementById('flowChart');
  if(!grand){
    box.innerHTML = `<p class="on-green-empty">Nenhum descarte validado nos últimos ${n} dias.</p>`;
  }else{
    const W = 320, H = 190, left = 32, right = 6, topPad = 16, base = 150;
    const max = Math.max(...dayTotals);
    const slot = (W - left - right) / n;
    const bw = Math.max(4, Math.min(22, slot * 0.72));
    const step = n <= 7 ? 1 : n <= 14 ? 2 : 5;
    let shapes = '';
    flow.days.forEach((day, i) => {
      const x = left + i * slot + (slot - bw) / 2;
      let y = base;
      list.forEach((p, k) => {
        const v = p[metric][i];
        if(!v) return;
        const h = (base - topPad) * v / max;
        y -= h;
        shapes += `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${bw.toFixed(1)}" height="${h.toFixed(1)}" fill="${flowColor(k)}"><title>${esc(shortPoint(p.name))}: ${v} ${METRIC_LABEL[metric]} em ${dayLabel(day)}</title></rect>`;
      });
      if(n <= 14 && dayTotals[i]) shapes += `<text x="${(x + bw / 2).toFixed(1)}" y="${(y - 4).toFixed(1)}" text-anchor="middle" font-size="10" font-weight="700" fill="#fff">${dayTotals[i]}</text>`;
      if((n - 1 - i) % step === 0) shapes += `<text x="${(x + bw / 2).toFixed(1)}" y="${base + 15}" text-anchor="middle" font-size="9.5" fill="#fff" opacity=".9">${dayLabel(day)}</text>`;
    });
    box.innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Fluxo diário de ${METRIC_LABEL[metric]} por ponto nos últimos ${n} dias">${shapes}<line x1="${left}" y1="${base}" x2="${W - right}" y2="${base}" stroke="#fff" opacity=".4"/><text x="${left - 5}" y="${topPad + 4}" text-anchor="end" font-size="10" fill="#fff" opacity=".9">${max}</text><text x="${left - 5}" y="${base + 3}" text-anchor="end" font-size="10" fill="#fff" opacity=".9">0</text></svg>`;
  }
  document.getElementById('flowLegend').innerHTML = list.map((p, k) =>
    `<li><i style="background:${flowColor(k)}"></i><span>${esc(shortPoint(p.name))} — ${p.totals[metric]}</span></li>`).join('');
  const order = list.map((p, k) => ({ p, k })).sort((a, b) => b.p.totals[metric] - a.p.totals[metric]);
  const topValue = Math.max(1, ...order.map(o => o.p.totals[metric]));
  document.getElementById('flowRank').innerHTML = order.map(({ p, k }) =>
    `<div class="rank-row"><span class="rank-name">${esc(shortPoint(p.name))}</span><div class="rank-track"><div class="rank-fill" style="width:${Math.round(100 * p.totals[metric] / topValue)}%;background:${flowColor(k)}"></div></div><b>${p.totals[metric]}</b></div>`).join('');
}

async function loadFlow(){
  const card = document.getElementById('monitorCard');
  try{
    flow = await api('/api/monitor/flow?days=' + flowDays);
    card.hidden = false;
    renderFlow();
  }catch(err){
    card.hidden = false;
    document.getElementById('flowChart').innerHTML = '<p class="on-green-empty">' + esc(err.message) + '</p>';
  }
}

document.querySelectorAll('#flowDays button').forEach(btn => btn.addEventListener('click', () => {
  flowDays = Number(btn.dataset.days);
  document.querySelectorAll('#flowDays button').forEach(b => b.classList.toggle('active', b === btn));
  loadFlow();
}));
document.querySelectorAll('#flowMetric button').forEach(btn => btn.addEventListener('click', () => {
  flowMetric = btn.dataset.metric;
  document.querySelectorAll('#flowMetric button').forEach(b => b.classList.toggle('active', b === btn));
  renderFlow();
}));
document.getElementById('flowRefresh').addEventListener('click', loadFlow);

renderPoints();
renderRegister();
renderRewards();

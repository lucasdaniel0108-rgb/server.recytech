document.getElementById('postPhoto').addEventListener('change', async e => {
  const file = e.target.files[0];
  postPhotoData = null;
  postPreview.hidden = true;
  if(!file) return;
  setPostMsg('Preparando a foto...', true);
  try{
    postPhotoData = await readImage(file);
    postPreview.src = postPhotoData;
    postPreview.hidden = false;
    setPostMsg('', true);
  }catch(err){
    e.target.value = '';
    setPostMsg(err.message, false);
  }
});

postForm.addEventListener('submit', async e => {
  e.preventDefault();
  if(!postPhotoData){ setPostMsg('Adicione uma foto do material.', false); return; }
  const btn = document.getElementById('postSubmit');
  btn.disabled = true;
  setPostMsg('Publicando...', true);
  try{
    await api('/api/posts', {
      title: val('postTitle'), category: val('postCategory'), price: val('postPrice'),
      description: val('postDesc'), address: val('postAddress'), bairro: val('postBairro'),
      contact: val('postContact'), photo: postPhotoData
    });
    resetComposer();
    openComposer(false);
    showNotice('Postagem publicada!');
    await loadPosts();
  }catch(err){
    setPostMsg(err.message, false);
  }finally{

  }
});


const STATUS_LABEL = { pendente: 'Aguardando validação', validado: 'Validado', recusado: 'Recusado', cancelado: 'Cancelado', expirado: 'Expirado' };
const fmtCode = code => code.slice(0, 4) + '-' + code.slice(4);
const fmtInvite = code => code.slice(0, 5) + '-' + code.slice(5);
const codeOnly = value => String(value || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
const shortPoint = name => String(name || '').replace(/^Ponto — /, '');

function doneList(){
  return me.disposals.filter(x => x.status === 'validado');
}

function logItem(x){
  const done = x.status === 'validado';
  const name = done ? (x.finalMaterial || x.material) : x.material;
  const qty = done ? (x.finalQty || x.qty) : x.qty;
  const right = done ? `<span class="pts">+${x.points} pts</span>` : `<span class="badge">${esc(STATUS_LABEL[x.status] || x.status)}</span>`;
  let sub = `${esc(x.point)} · ${esc(when(x.validatedAt || x.createdAt))}`;
  if(x.status === 'pendente') sub = `Código ${esc(fmtCode(x.code))} · vale até ${esc(when(x.expiresAt))}`;
  if(x.status === 'recusado' && x.rejectReason) sub += ` · ${esc(x.rejectReason)}`;
  const dim = (x.status === 'recusado' || x.status === 'cancelado' || x.status === 'expirado') ? ' dim' : '';
  return `<div class="log-item${dim}"><div><b>${esc(name)} × ${qty}</b><small>${sub}</small></div>${right}</div>`;
}

function applyRole(){
  const staff = me.role === 'funcionario' || me.role === 'admin';
  document.getElementById('navEquipe').hidden = !staff;
  document.getElementById('teamAccess').hidden = staff;
  document.getElementById('adminCard').hidden = me.role !== 'admin';
  if(!staff) document.getElementById('monitorCard').hidden = true;
  if(!staff && document.getElementById('equipe').classList.contains('active')) activateTab('perfil');
}

function renderPending(){
  const list = me ? me.disposals.filter(x => x.status === 'pendente') : [];
  const shown = document.getElementById('codeBig').textContent;
  if(!document.getElementById('codeCard').hidden && !list.some(x => fmtCode(x.code) === shown)) document.getElementById('codeCard').hidden = true;
  document.getElementById('pendingCard').hidden = !list.length;
  document.getElementById('pendingList').innerHTML = list.map(x => `
    <div class="pending-item">
      <div><b>${esc(x.material)} × ${x.qty}</b><small>${esc(x.point)}</small><small>Código ${esc(fmtCode(x.code))} · vale até ${esc(when(x.expiresAt))}</small></div>
      <div class="pending-actions">
        <button class="btn-soft" type="button" data-show="${x.id}">Mostrar</button>
        <button class="btn-soft" type="button" data-cancel="${x.id}">Cancelar</button>
      </div>
    </div>`).join('');
}

function showCode(x){
  const mat = MATERIALS.find(m => m.id === x.materialId);
  document.getElementById('codeBig').textContent = fmtCode(x.code);
  document.getElementById('codeInfo').textContent = `Mostre este código ao funcionário do ${x.point} até ${when(x.expiresAt)}. Estimativa: ${pts(mat ? mat.pts * x.qty : 0)}. O valor final é confirmado no ponto.`;
  const box = document.getElementById('qrBox');
  box.innerHTML = '';
  if(window.QRCode){
    try{
      new QRCode(box, { text: x.code, width: 168, height: 168, colorDark: '#0b2a14', colorLight: '#ffffff', correctLevel: QRCode.CorrectLevel.M });
    }catch(e){
      box.innerHTML = '';
    }
  }
  document.getElementById('codeCard').hidden = false;
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

document.getElementById('codeClose').addEventListener('click', () => { document.getElementById('codeCard').hidden = true; });
document.getElementById('pendingList').addEventListener('click', async e => {
  const show = e.target.closest('button[data-show]');
  const cancel = e.target.closest('button[data-cancel]');
  if(show){
    const x = me.disposals.find(d => String(d.id) === show.dataset.show);

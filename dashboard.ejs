    <img class="post-photo" src="${esc(p.photoUrl)}" alt="Foto: ${esc(p.title)}" loading="lazy">
    <div class="post-body">
      <h4>${esc(p.title)}</h4>
      <div class="post-meta"><span class="chip">${esc(p.category)}</span><span class="price">${esc(money(p.priceCents))}</span></div>
      ${p.description ? `<p class="post-desc">${esc(p.description)}</p>` : ''}

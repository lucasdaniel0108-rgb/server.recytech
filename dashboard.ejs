<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>RecyTech — Descarte Certo, Recompensa Real</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
  :root{
    --green:#1f8a4c; --green-dark:#15672f; --green-light:#e6f5eb;
    --bg:#f7faf8; --card:#ffffff; --text:#16241c; --muted:#5a6b62; --border:#e1e9e3;
    box-sizing:border-box;
    padding-top: env(safe-area-inset-top,0px);
    padding-bottom: env(safe-area-inset-bottom,0px);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#0f1712; --card:#17211b; --text:#eaf3ee; --muted:#9db2a7; --border:#25322b; --green-light:#152a1e;
    }
  }
  :root[data-theme="dark"]{
    --bg:#0f1712; --card:#17211b; --text:#eaf3ee; --muted:#9db2a7; --border:#25322b; --green-light:#152a1e;
  }
  *{box-sizing:border-box;}
  html{scroll-padding-top: env(safe-area-inset-top,0px);}
  [hidden]{display:none !important;}
  body{margin:0;background:#041a0b;color:#fff;font-family:Inter,system-ui,sans-serif;line-height:1.5;padding-bottom:calc(88px + env(safe-area-inset-bottom,0px));}
  h1,h2,h3{font-family:Poppins,system-ui,sans-serif;margin:0 0 8px;}
  .wrap{max-width:920px;margin:0 auto;padding:0 20px;}
  section.panel{display:none;padding:22px 0 40px;}
  section.panel.active{display:block;}
  footer{text-align:center;color:rgba(255,255,255,.7);font-size:.78rem;padding:20px 0;}
  #realMap{position:relative;width:100%;aspect-ratio:16/10;overflow:hidden;z-index:0;}
  .leaflet-popup-content b{font-family:Poppins,sans-serif;}
  .svg-defs{position:absolute;width:0;height:0;overflow:hidden;}
  #profileBg{position:fixed;inset:0;z-index:-2;display:block;background:
    radial-gradient(ellipse 90% 60% at 100% 100%,rgba(16,128,56,.9),transparent 72%),
    linear-gradient(125deg,#0c4a22 0%,#093818 48%,#020c06 100%);}
  #profileBg::after{content:"";position:absolute;inset:0;background:radial-gradient(rgba(255,255,255,.13) 1.2px,transparent 1.8px) 0 0/12px 12px;-webkit-mask-image:linear-gradient(135deg,#000 0%,transparent 62%);mask-image:linear-gradient(135deg,#000 0%,transparent 62%);}

  .rough{position:relative;isolation:isolate;color:#fff;}
  .rough::before{content:"";position:absolute;inset:0;z-index:-1;background:#4a8b45;border-radius:6px;filter:url(#rough);}
  .profile{max-width:520px;margin:0 auto;padding-top:6px;}
  .profile-top{display:flex;align-items:center;gap:16px;}
  .avatar-lg{width:92px;height:92px;border-radius:50%;border:3px solid #fff;flex:none;overflow:hidden;background:#000;}
  .avatar-lg svg{display:block;width:100%;height:100%;}
  .who-lg{flex:1;min-width:0;}
  .who-lg h2{margin:0;font-size:1.5rem;color:#fff;overflow-wrap:anywhere;line-height:1.2;}
  .who-lg p{margin:4px 0 0;font-weight:600;font-size:.92rem;color:#fff;}
  .logout{align-self:flex-start;background:rgba(255,255,255,.14);color:#fff;border:1px solid rgba(255,255,255,.3);border-radius:999px;padding:6px 12px;font-weight:600;font-size:.78rem;cursor:pointer;font-family:inherit;}
  .stats{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:28px 0 24px;}
  .stat-box{padding:20px 12px;text-align:center;}
  .stat-box b{display:block;font-family:Poppins,sans-serif;font-size:1.9rem;line-height:1.15;}
  .stat-box span{font-weight:700;font-size:.92rem;}
  .big-card{padding:22px 22px 24px;margin-bottom:24px;}
  .big-card h3{color:#fff;font-size:1.15rem;margin:0 0 12px;}
  .seg{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap;}
  .seg button{background:rgba(255,255,255,.16);color:#fff;border:none;border-radius:999px;padding:6px 14px;font-weight:600;font-size:.8rem;cursor:pointer;font-family:inherit;}
  .seg button.active{background:#fff;color:#1d4d1f;}
  .chart-box{min-height:150px;}
  .chart-box > svg{display:block;width:100%;max-width:440px;height:auto;margin:0 auto;}
  .chart-note{margin:8px 0 0;font-size:.82rem;opacity:.92;}
  .donut-wrap{display:flex;gap:16px;align-items:center;flex-wrap:wrap;}
  .donut-wrap svg{display:block;width:150px;flex:none;}
  .legend{list-style:none;margin:0;padding:0;font-size:.82rem;flex:1;min-width:150px;}
  .legend li{display:flex;align-items:center;gap:8px;margin:5px 0;}
  .legend i{width:10px;height:10px;border-radius:3px;flex:none;}
  .log{max-height:300px;overflow:auto;}
  .log-item{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.22);}
  .log-item:last-child{border-bottom:none;}
  .log-item b{font-weight:700;font-size:.9rem;}
  .log-item small{display:block;opacity:.88;font-size:.76rem;}
  .log-item .pts{font-weight:700;white-space:nowrap;}
  .on-green-empty{opacity:.92;font-size:.88rem;padding:14px 0;text-align:center;margin:0;}


  .page-green{max-width:560px;margin:0 auto;padding-top:6px;}
  .page-head h2{margin:0;color:#fff;font-size:1.5rem;}
  .page-head p{margin:4px 0 0;color:#fff;opacity:.92;font-size:.92rem;}
  .page-head{margin-bottom:22px;}
  .page-head-row{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;flex-wrap:wrap;}
  .map-card{padding:16px;margin:0 0 24px;}
  .map-card #realMap{border:none;border-radius:6px;aspect-ratio:4/3;}
  .tiles{display:grid;grid-template-columns:1fr 1fr;gap:18px;}
  @media(max-width:340px){.tiles{grid-template-columns:1fr;}}
  .tile{padding:16px 14px 14px;min-height:225px;display:flex;flex-direction:column;}
  .tile::before{background:#3b7537;}
  .tile h4{margin:0 0 6px;font-family:Poppins,sans-serif;font-size:.98rem;line-height:1.25;color:#fff;overflow-wrap:anywhere;}
  .tile p{margin:0 0 6px;font-size:.8rem;overflow-wrap:anywhere;}
  .tile-addr{font-weight:600;}
  .tile-bairro,.tile-accepts{opacity:.9;}
  .tile-hours small{display:block;opacity:.88;font-size:.72rem;}
  .status{display:inline-block;font-weight:700;font-size:.74rem;line-height:1.3;padding:3px 9px;border-radius:10px;margin-bottom:3px;}
  .status.open{background:#d7f5c9;color:#14501f;}
  .status.closed{background:rgba(0,0,0,.3);color:#fff;}
  .tile-actions{margin-top:auto;display:flex;flex-direction:column;gap:6px;padding-top:8px;}
  .tile-actions button,.tile-actions a{display:block;text-align:center;text-decoration:none;background:rgba(255,255,255,.16);color:#fff;border:1px solid rgba(255,255,255,.3);border-radius:999px;padding:6px 10px;font-weight:600;font-size:.76rem;cursor:pointer;font-family:inherit;}
  .tiles-note{margin:16px 0 0;font-size:.76rem;opacity:.9;}

  .bottom-nav{position:fixed;left:0;right:0;bottom:0;z-index:50;background:rgba(15,23,18,.94);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-top:1px solid var(--border);padding:6px 8px calc(6px + env(safe-area-inset-bottom,0px));}
  .bottom-nav .inner{display:flex;max-width:560px;margin:0 auto;justify-content:space-between;align-items:flex-end;}
  .nav-btn{flex:1;min-width:0;background:none;border:none;color:#fff;display:flex;flex-direction:column;align-items:center;gap:3px;padding:4px 0;cursor:pointer;font-family:inherit;font-size:.62rem;font-weight:600;white-space:nowrap;opacity:.62;}
  .nav-btn.active{opacity:1;}
  .nav-btn .ico{display:flex;align-items:center;justify-content:center;padding:4px 14px;border-radius:999px;}
  .nav-btn.active .ico{background:rgba(31,138,76,.5);}
  .nav-btn img,.nav-btn svg{width:26px;height:26px;display:block;object-fit:contain;fill:#fff;}
  .nav-btn.center{opacity:1;}
  .nav-btn.center .ico{background:var(--green);padding:11px;margin-top:-16px;box-shadow:0 4px 14px rgba(0,0,0,.45);border:3px solid rgba(15,23,18,.94);}
  .nav-btn.center.active .ico{background:#27a85f;}
  .nav-btn.center span:last-child{opacity:.75;}
  .nav-btn.center.active span:last-child{opacity:1;}

  input:focus-visible,textarea:focus-visible,select:focus-visible,button:focus-visible,a:focus-visible{outline:2px solid #fff;outline-offset:2px;}
  .rough label{display:block;font-weight:600;font-size:.85rem;margin:14px 0 6px;color:#fff;}
  .big-card > label:first-child{margin-top:0;}
  .rough input[type=text],.rough input[type=number],.rough input[type=tel],.rough input[type=search],.rough textarea,.rough select,.post-filters input[type=search]{width:100%;padding:10px 12px;border-radius:10px;border:1px solid rgba(255,255,255,.3);background:rgba(0,0,0,.24);color:#fff;font-size:.92rem;font-family:inherit;}
  .rough select option{background:#17301c;color:#fff;}
  ::placeholder{color:rgba(255,255,255,.6);}
  .rough textarea{resize:vertical;min-height:80px;}
  .rough input[type=file]{width:100%;font-size:.86rem;color:rgba(255,255,255,.88);}
  .rough input[type=file]::file-selector-button{background:rgba(255,255,255,.18);color:#fff;border:1px solid rgba(255,255,255,.35);border-radius:999px;padding:6px 12px;font-weight:600;margin-right:10px;cursor:pointer;font-family:inherit;}
  .rough input[type=range]{width:100%;accent-color:#fff;}
  .qty-row{display:flex;align-items:center;gap:12px;}
  .qty-row output{font-weight:700;min-width:28px;text-align:center;color:#fff;}
  .btn-white{background:#fff;color:#14501f;border:none;border-radius:999px;padding:10px 18px;font-weight:700;font-size:.9rem;cursor:pointer;font-family:inherit;}
  .btn-white.wide{display:block;width:100%;margin-top:18px;padding:12px 18px;font-size:.95rem;}
  .btn-white:disabled{opacity:.55;cursor:not-allowed;}
  .btn-soft{background:rgba(255,255,255,.16);color:#fff;border:1px solid rgba(255,255,255,.32);border-radius:999px;padding:8px 14px;font-weight:600;font-size:.82rem;cursor:pointer;font-family:inherit;}
  .btn-soft:disabled{opacity:.45;cursor:not-allowed;}
  .note{font-size:.78rem;color:#fff;background:rgba(0,0,0,.22);border-radius:10px;padding:10px 12px;margin:14px 0 0;}
  .hint{font-size:.78rem;color:#fff;opacity:.9;margin:6px 0 0;}
  .form-msg{font-size:.84rem;margin:12px 0 0;min-height:1.2em;color:#fff;}
  .form-msg.ok{color:#d7f5c9;font-weight:600;}
  .form-msg.bad{color:#ffd0cc;font-weight:600;}
  .empty{color:#fff;opacity:.9;font-size:.88rem;text-align:center;padding:20px 0;margin:0;}
  .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 14px;}
  @media(max-width:600px){.form-grid{grid-template-columns:1fr;}}
  .post-preview{display:block;width:100%;max-height:260px;object-fit:cover;border-radius:8px;margin-top:10px;}
  .form-actions{display:flex;gap:10px;align-items:center;margin-top:14px;}
  .post-filters{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:6px 0 20px;}
  .post-filters input[type=search]{flex:1;min-width:170px;width:auto;}
  .chips{display:flex;gap:6px;}
  .filter-btn{border:1px solid rgba(255,255,255,.32);background:rgba(255,255,255,.12);color:#fff;padding:7px 12px;border-radius:999px;font-weight:600;font-size:.8rem;cursor:pointer;font-family:inherit;}
  .filter-btn.active{background:#fff;border-color:#fff;color:#1d4d1f;}
  .post{padding:14px 14px 16px;margin-bottom:22px;}
  .post.done{opacity:.7;}
  .post-top{display:flex;align-items:center;gap:10px;padding-bottom:12px;}
  .post-top .who{flex:1;min-width:0;}
  .post-top .who b{display:block;font-size:.9rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .post-top .who small{opacity:.88;font-size:.76rem;}
  .avatar{width:36px;height:36px;border-radius:50%;background:#0b2a14;color:#fff;border:2px solid #fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-family:Poppins,sans-serif;flex:none;}
  .post-photo{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:8px;background:rgba(0,0,0,.25);}
  .post-body{padding:12px 0 0;}
  .post-body h4{margin:0 0 8px;font-family:Poppins,sans-serif;font-size:1.02rem;color:#fff;}
  .post-meta{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:8px;}
  .chip{background:rgba(0,0,0,.28);color:#fff;font-size:.72rem;font-weight:600;padding:2px 9px;border-radius:999px;white-space:nowrap;}
  .price{font-weight:700;font-family:Poppins,sans-serif;font-size:.95rem;}
  .post-desc{margin:0 0 8px;font-size:.88rem;white-space:pre-wrap;overflow-wrap:anywhere;}
  .post-addr{margin:0 0 12px;opacity:.92;font-size:.84rem;overflow-wrap:anywhere;}
  .post-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
  .whats{display:inline-block;background:#fff;color:#14501f;padding:9px 14px;border-radius:999px;font-weight:700;font-size:.85rem;text-decoration:none;}
  .phone{opacity:.88;font-size:.82rem;}
  .reward{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 16px;margin-bottom:16px;}
  .reward::before{background:#3b7537;}
  .reward h4{margin:0 0 2px;font-size:.95rem;color:#fff;}
  .reward p{margin:0;opacity:.9;font-size:.8rem;}
  .history-item{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.22);font-size:.88rem;}
  .history-item:last-child{border-bottom:none;}
  .history-item b{white-space:nowrap;}
  .balance-box{padding:18px 12px;margin-bottom:12px;}

  .rough small{opacity:.88;font-size:.76rem;}
  .mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.08em;}
  .code-big{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:2.1rem;font-weight:700;letter-spacing:.12em;text-align:center;background:rgba(0,0,0,.25);border-radius:10px;padding:14px 8px;margin:6px 0 14px;}
  .qr-box{display:flex;justify-content:center;margin:0 0 12px;}
  .qr-box img,.qr-box canvas{background:#fff;padding:10px;border-radius:8px;}
  .rough input.code-input{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:1.25rem;letter-spacing:.14em;text-align:center;text-transform:uppercase;}
  .badge{background:rgba(0,0,0,.3);color:#fff;border-radius:999px;padding:2px 10px;font-size:.72rem;font-weight:700;white-space:nowrap;}
  .log-item.dim{opacity:.62;}
  .pending-item{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.22);}
  .pending-item:last-child{border-bottom:none;}
  .pending-item small{display:block;}
  .pending-actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;}
  #teamAccess{margin-bottom:24px;}
  .staff-actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:14px;}
  .staff-actions select{flex:1;min-width:180px;width:auto;}
  .result-box{margin-top:14px;padding:14px;background:rgba(0,0,0,.2);border-radius:10px;}
  .result-box p{margin:0 0 4px;}
  #scanBox video{display:block;width:100%;max-height:300px;border-radius:10px;background:#000;margin:12px 0 8px;object-fit:cover;}
  .admin-sub{font-family:Poppins,sans-serif;font-size:1rem;margin:22px 0 8px;color:#fff;}
  .csv-link{display:inline-block;margin-top:16px;text-decoration:none;}
  #resReason{flex:1 1 100%;}

  .how-steps{display:flex;gap:8px;margin:0 0 20px;}
  .how-step{flex:1;text-align:center;font-size:.74rem;font-weight:600;line-height:1.25;}
  .how-step i{display:flex;align-items:center;justify-content:center;width:28px;height:28px;margin:0 auto 6px;border-radius:50%;background:#fff;color:#14501f;font-style:normal;font-weight:700;font-size:.85rem;}
  .step-title{display:flex;align-items:center;gap:10px;margin:0 0 14px;}
  .step-title h3{margin:0;}
  .step-num{display:flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:#fff;color:#14501f;font-weight:700;font-size:.85rem;flex:none;}
  .mat-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;}
  .mat-card{display:flex;flex-direction:column;gap:2px;align-items:flex-start;text-align:left;background:rgba(0,0,0,.22);color:#fff;border:2px solid transparent;border-radius:12px;padding:12px;cursor:pointer;font-family:inherit;}
  .mat-card .mat-ico{font-size:1.6rem;line-height:1.1;margin-bottom:4px;}
  .mat-card b{font-size:.86rem;}
  .mat-card small{font-size:.74rem;opacity:.9;}
  .mat-card.selected{background:#fff;color:#14501f;border-color:#fff;}
  .pt-list{display:flex;flex-direction:column;gap:8px;}
  .pt-row{display:flex;align-items:center;gap:12px;text-align:left;background:rgba(0,0,0,.22);color:#fff;border:2px solid transparent;border-radius:12px;padding:10px 12px;cursor:pointer;font-family:inherit;width:100%;}
  .pt-row .radio{width:18px;height:18px;border-radius:50%;border:2px solid rgba(255,255,255,.8);flex:none;position:relative;}
  .pt-row.selected{background:#fff;color:#14501f;border-color:#fff;}
  .pt-row.selected .radio{border-color:#14501f;}
  .pt-row.selected .radio::after{content:"";position:absolute;inset:3px;border-radius:50%;background:#14501f;}
  .pt-main{flex:1;min-width:0;}
  .pt-main b{display:block;font-size:.9rem;}
  .pt-main small{display:block;font-size:.74rem;opacity:.85;overflow-wrap:anywhere;}
  .pt-row .status{margin:0;white-space:nowrap;}
  .pt-row.selected .status.closed{background:rgba(0,0,0,.12);color:#14501f;}
  .stepper{display:flex;align-items:center;justify-content:center;gap:18px;margin:4px 0 14px;}
  .stepper button{width:46px;height:46px;border-radius:50%;border:2px solid rgba(255,255,255,.6);background:rgba(255,255,255,.14);color:#fff;font-size:1.5rem;line-height:1;cursor:pointer;font-family:inherit;}
  .stepper button:disabled{opacity:.4;cursor:not-allowed;}
  .stepper output{min-width:64px;text-align:center;font-family:Poppins,sans-serif;font-size:2.4rem;font-weight:700;}
  .qty-chips{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;}
  .qty-chip{border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.12);color:#fff;border-radius:999px;padding:6px 14px;font-weight:600;font-size:.82rem;cursor:pointer;font-family:inherit;}
  .qty-chip.active{background:#fff;color:#14501f;border-color:#fff;}
  .est-box{text-align:center;padding:6px 0 4px;}
  .est-box .est-num{display:block;font-family:Poppins,sans-serif;font-size:2.6rem;font-weight:700;line-height:1.1;}
  .est-box .est-label{font-weight:700;font-size:.95rem;}
  .est-box p{margin:8px 0 0;font-size:.8rem;opacity:.92;}
  .monitor-head{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:6px;}
  .monitor-head h3{margin:0;}
  .pillset{display:flex;gap:6px;margin:0 0 10px;flex-wrap:wrap;}
  .pillset button{background:rgba(255,255,255,.16);color:#fff;border:none;border-radius:999px;padding:6px 14px;font-weight:600;font-size:.8rem;cursor:pointer;font-family:inherit;}
  .pillset button.active{background:#fff;color:#1d4d1f;}
  .kpis{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:12px 0 4px;}
  .kpi{background:rgba(0,0,0,.22);border-radius:10px;padding:10px 12px;}
  .kpi b{display:block;font-family:Poppins,sans-serif;font-size:1.5rem;line-height:1.2;}
  .kpi span{font-size:.74rem;opacity:.92;}
  .rank-row{display:flex;align-items:center;gap:10px;margin:8px 0;font-size:.82rem;}
  .rank-name{flex:0 0 44%;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .rank-track{flex:1;height:12px;border-radius:999px;background:rgba(0,0,0,.25);overflow:hidden;}
  .rank-fill{height:100%;border-radius:999px;}
  .rank-row b{min-width:34px;text-align:right;}

  .mat-card.locked{opacity:.78;}
  .mat-card.selected.locked{opacity:1;}
  .mini-bar{display:block;width:100%;height:6px;border-radius:999px;background:rgba(0,0,0,.28);margin-top:8px;overflow:hidden;}
  .mini-bar i{display:block;height:100%;background:#fff;border-radius:999px;}
  .mat-card.selected .mini-bar{background:rgba(20,80,31,.2);}
  .mat-card.selected .mini-bar i{background:#14501f;}
  .progress{height:12px;border-radius:999px;background:rgba(0,0,0,.28);overflow:hidden;margin:14px auto 8px;max-width:320px;}
  .progress-fill{height:100%;width:0;background:#fff;border-radius:999px;transition:width .35s ease;}
  .reward-summary{margin-bottom:6px;}
  .sum-row{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.22);font-size:.9rem;}
  .sum-row:last-child{border-bottom:none;}
  .sum-row b{text-align:right;}
</style>

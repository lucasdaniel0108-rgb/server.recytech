<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EcoBetim — <%= mode === 'login' ? 'Entrar' : 'Criar conta' %></title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{--green:#1f8a4c;--green-dark:#15672f;--bg:#f7faf8;--card:#fff;--text:#16241c;--muted:#5a6b62;--border:#e1e9e3;}
  *{box-sizing:border-box;}
  body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg);font-family:Inter,system-ui,sans-serif;color:var(--text);padding:20px;}
  .card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:32px;max-width:380px;width:100%;}
  h1{font-family:Poppins,sans-serif;font-size:1.3rem;margin:0 0 4px;text-align:center;}
  p.sub{color:var(--muted);text-align:center;font-size:.88rem;margin:0 0 20px;}
  label{display:block;font-weight:600;font-size:.85rem;margin:14px 0 6px;}
  input{width:100%;padding:11px;border-radius:10px;border:1px solid var(--border);font-size:.95rem;}
  button{width:100%;margin-top:20px;background:var(--green);color:#fff;border:none;padding:12px;border-radius:10px;font-weight:700;font-size:.95rem;cursor:pointer;}
  .error{background:#fde8e8;color:#9b1c1c;padding:10px 12px;border-radius:10px;font-size:.85rem;margin-top:14px;}
  .switch{text-align:center;margin-top:18px;font-size:.85rem;color:var(--muted);}
  .switch a{color:var(--green-dark);font-weight:600;text-decoration:none;}
</style>
</head>
<body>
  <div class="card">
    <h1>♻️ EcoBetim</h1>
    <p class="sub"><%= mode === 'login' ? 'Entre na sua conta' : 'Crie sua conta' %></p>
    <form method="POST" action="<%= mode === 'login' ? '/login' : '/cadastro' %>">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <% if (mode === 'cadastro') { %>
        <label for="name">Nome</label>
        <input type="text" id="name" name="name" required value="<%= values.name || '' %>">
      <% } %>
      <label for="email">E-mail</label>
      <input type="email" id="email" name="email" required value="<%= values.email || '' %>">
      <label for="password">Senha</label>
      <input type="password" id="password" name="password" required minlength="6">
      <% if (error) { %><p class="error"><%= error %></p><% } %>
      <button type="submit"><%= mode === 'login' ? 'Entrar' : 'Criar conta' %></button>
    </form>
    <p class="switch">
      <% if (mode === 'login') { %>Não tem conta? <a href="/cadastro">Criar conta</a>
      <% } else { %>Já tem conta? <a href="/login">Entrar</a><% } %>
    </p>
  </div>
</body>
</html>
